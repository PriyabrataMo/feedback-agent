# Copy to .env (gitignored). Without OPENAI_API_KEY the agent is a mock.
OPENAI_API_KEY=
# REALTIME_MODEL=gpt-realtime
# REALTIME_VOICE=marin
# APP_ENV=development
# DEV_STORAGE_SECRET=change-me
# Storage: local (dev disk) or s3 (see docs/s3-storage.md)
# STORAGE_BACKEND=local
# S3_BUCKET= / S3_REGION= / S3_ENDPOINT_URL= / S3_KEY_PREFIX=
# Tickets (see docs/tickets.md): Linear wins over webhook when both are set
# LINEAR_API_KEY= / LINEAR_TEAM_ID= / LINEAR_LABEL_IDS=
# TICKET_WEBHOOK_URL= / TICKET_WEBHOOK_SECRET=
# TICKET_SUMMARY_MODEL=gpt-4o-mini
# DASHBOARD_BASE_URL=http://localhost:3000
# Waitlist (landing page): GET /admin/waitlist[.csv] needs `Authorization: Bearer $WAITLIST_ADMIN_TOKEN`
# (unset = those endpoints return 404). Use a long random value, e.g. `openssl rand -hex 32`.
# WAITLIST_ADMIN_TOKEN=
# WAITLIST_IP_SALT=change-me
# Persist DATA_DIR on a durable volume: waitlist rows live in $DATA_DIR/sessions.db
